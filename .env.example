# OpenRouter is the only LLM API used by the current portal.
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-5.6-sol
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_TITLE=XPRS Portal
# Mandatory provider-side privacy controls. The portal refuses OpenRouter calls
# if ZDR is disabled and only permits endpoints that deny data collection.
OPENROUTER_ZDR_REQUIRED=true
OPENROUTER_DATA_COLLECTION=deny

# The repository ships a one-individual public demonstration bundle. Replace
# these paths with the full processed-data locations in a controlled deployment.
GENE_IMPORTANCE_CSV=data/demo/all_individuals_gene_importance.csv
OT_MERGED_CSV=data/demo/ot_breast_carcinoma_gene_associations.csv
PLOT_DATA_CACHE_DIR=data/demo/plot_cache

# Reference extraction also uses OpenRouter, with GPT-5 mini as the model.
REFERENCE_EXTRACTION_PROVIDER=openrouter
REFERENCE_EXTRACTION_MODEL=openai/gpt-5-mini
ENABLE_LLM_REFERENCE_EXTRACTION=true
REFERENCE_EXTRACTION_BATCH_SIZE=10
REFERENCE_EXTRACTION_TIMEOUT=30

# Semantic Scholar is the only other external API key. Europe PMC is the
# public, keyless primary literature source; Semantic Scholar supplements a
# query only when Europe PMC supplies fewer than the interactive target.
S2_API_KEY=
EUROPE_PMC_CACHE_DIR=cache_literature/europe_pmc
# Small result pages reduce the load of abstract-rich interactive searches.
S2_GENERAL_LIMIT=10
S2_PRIMARY_LIMIT=10
S2_NAMED_PHENOTYPE_LIMIT=10
S2_PUBLIC_MIN_INTERVAL_SECONDS=2.0
# Interactive requests use a modest baseline interval. Background pagination
# has a separate, more conservative interval below.
S2_API_KEY_MIN_INTERVAL_SECONDS=15.0
S2_REQUEST_JITTER_SECONDS=0.25
S2_DEFAULT_MAX_RETRIES=3
# Interactive 429 backoff: 30s, 1m, 2m, 4m, 8m, then at most 10m
# (unless Retry-After is longer). Only the initial cooldown is waited through
# during an active summary request.
S2_RUNTIME_RATE_LIMIT_COOLDOWN_BASE_SECONDS=30
S2_RUNTIME_RATE_LIMIT_COOLDOWN_MAX_SECONDS=600

# Europe PMC stops interactive retrieval after five eligible papers. When it
# falls short, Semantic Scholar is queried as a fallback/augmentation source.
LITERATURE_MINIMUM_INTERACTIVE_ELIGIBLE_DOCUMENTS=5
# Adaptive Semantic Scholar fallback pagination. A cold fallback fetches a
# 10-paper first page and, only when the combined provider yield remains below
# five eligible papers, one synchronous rescue page. Remaining S2 pages are
# filled by one shared background worker, which yields to interactive requests.
S2_ENRICHMENT_PAGE_SIZE=10
S2_ENRICHMENT_MAX_RAW_RESULTS=50
S2_ENRICHMENT_GENERAL_TARGET=30
S2_ENRICHMENT_PRIMARY_TARGET=20
S2_ENRICHMENT_NAMED_TARGET=15
S2_ENRICHMENT_ZERO_YIELD_PAGES=2
S2_ENRICHMENT_START_DELAY_SECONDS=30
# Live keyed searches in this deployment behave like a roughly one-per-minute
# rolling allowance. Apply that spacing to background pages and queued jobs.
S2_ENRICHMENT_API_KEY_MIN_INTERVAL_SECONDS=60

# Local dense retrieval and biomedical reranking.
RERANKER_ENABLED=true
RERANKER_MODEL=ncbi/MedCPT-Cross-Encoder
RERANKER_CANDIDATE_K=30
RERANKER_BATCH_SIZE=8
RERANKER_MAX_LENGTH=512

# Disable persistent conversation logs for a public deployment unless needed.
SESSION_LOGGING_ENABLED=false
EPHEMERAL_SESSION_LIMIT=100

# Protection for the unlinked, read-only retrieval administration page.
# The route is disabled when this is empty. Set it, then open
# /admin/documents#token=VALUE once to store an HTTP-only access cookie.
XPRS_ADMIN_TOKEN=

# Unlinked internal pilot survey. The page and submission API return 404 when
# this is empty. Share links as /evaluation#token=VALUE so the token is not
# transmitted in the initial URL or written to the server access log.
XPRS_EVALUATION_TOKEN=
EVALUATION_RESPONSES_DIR=evaluation_responses
# Set true when the portal is served through HTTPS.
XPRS_COOKIE_SECURE=false

# --- Private K-PREDICT cohort (local deployment only) ---
KPREDICT_ENABLED=false
KPREDICT_DATA_ROOT=
# Use a dedicated private-cohort code. The administrator code remains a
# deployment fallback but should not be distributed to cohort users.
XPRS_KPREDICT_TOKEN=
