# Secrets and local configuration
.env
.env.*
!.env.example

# Local environments and Python build artifacts
.xprs_portal/
.venv/
venv/
__pycache__/
*.py[cod]
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Internal meeting notes may contain private cohort aggregate statistics.
docs/weekly-progress-*.md

# Runtime state
logs/*
!logs/.gitkeep
cache_s2/*
!cache_s2/.gitkeep
cache_literature/*
!cache_literature/.gitkeep
chroma/*
!chroma/.gitkeep
evaluation_responses/
*.sqlite3
*.log

# Full-cohort artifacts and derivatives are distributed separately after
# provenance/licensing review. Keep only documentation and the demo profile.
data/*
!data/README.md
!data/demo/
!data/demo/**

# Controlled K-PREDICT/private cohort inputs must remain outside the public repository.
# These patterns are defensive: production deployments should configure an
# external data root rather than placing private material anywhere in this tree.
private_data/
data_private/
*_cohort.RDS
*_cohort.rds
xprs_rare_findings_*.tsv

# Large/derived R inputs and generated browser plot payloads
r/*.RDS
r/*.rds
r/*.fam
static/plots/*

# Source-paper copies are local inputs; curated Markdown notes remain publishable.
ref/*.pdf
ref/*.txt

# Generated benchmark corpora, vector stores, and review exports
benchmarks/**/candidates.json
benchmarks/**/corpus.json
benchmarks/**/embeddings.npy
benchmarks/**/fetch_stats.json
benchmarks/**/partial_results.json
benchmarks/**/results.json
benchmarks/**/blinded_review.csv
benchmarks/**/review_mapping.json
benchmarks/**/raw_s2/
benchmarks/**/chroma/
benchmarks/**/lancedb/

# Editor and operating-system files
.DS_Store
.idea/
.vscode/
*~
*.swp
*.tmp
